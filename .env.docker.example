NODE_ENV=production
PORT=4000
DATABASE_URL=mongodb://mongodb:27017/maryme?replicaSet=rs0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-character-secret
COOKIE_SECURE=false

# Explicit SUPER_ADMIN bootstrap only; inject real values as secrets.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=+22670000000
SUPER_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=Maryme
