NODE_ENV=development
PORT=4000
# Local replica set. Atlas alternative (placeholders only):
# DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER/maryme?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/maryme?replicaSet=rs0&directConnection=true
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-at-least-32-character-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false
ARGON2_MEMORY_COST=19456

# Explicit SUPER_ADMIN bootstrap only; replace these values locally/securely.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=+22670000000
SUPER_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=Maryme
