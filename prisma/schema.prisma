generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COUPLE
  ACCESS_AGENT
}

enum CoupleStatus {
  PENDING
  AUTHORIZED
  SUSPENDED
}

enum GuestSide {
  GROOM
  BRIDE
}

enum GuestCategory {
  BRIDE_FAMILY
  GROOM_FAMILY
  WITNESS
  FRIENDS
  COLLEAGUES
  VIP
}

enum RsvpStatus {
  CONFIRMED
  PENDING
  DECLINED
}

enum DietaryRequirement {
  STANDARD
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  CHILD_MENU
  HALAL
  NO_SEAFOOD
}

enum InvitationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum CheckInStatus {
  VALID
  DUPLICATE
  REJECTED
}

model User {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  email            String           @unique
  phone            String           @unique
  passwordHash     String
  role             UserRole
  firstName        String?
  lastName         String?
  isActive         Boolean          @default(true)
  coupleId         String?          @db.ObjectId
  couple           Couple?          @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  refreshSessions  RefreshSession[]
  operatedCheckIns CheckIn[]        @relation("CheckInOperator")
  audits           AuditLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastLoginAt      DateTime?

  @@index([coupleId])
}

model Couple {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  partner1         String
  partner2         String
  partner1FullName String?
  partner2FullName String?
  weddingDate      DateTime
  location         String
  email            String
  phone            String
  status           CoupleStatus @default(PENDING)
  guestQuota       Int
  requestDate      DateTime     @default(now())
  authorizedAt     DateTime?
  notes            String?
  budgetEstimate   Int?
  bibleVerse       String?
  lunchVenue       String?
  lunchTime        String?
  churchVenue      String?
  churchTime       String?
  cityHallVenue    String?
  cityHallTime     String?
  groomFamilies    String[]     @default([])
  brideFamilies    String[]     @default([])
  users            User[]
  guests           Guest[]
  invitations      Invitation[]
  checkIns         CheckIn[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  accessOpensAt    DateTime?
  accessClosesAt   DateTime?

  @@index([status])
}

model Guest {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  coupleId           String             @db.ObjectId
  couple             Couple             @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  firstName          String
  lastName           String
  side               GuestSide
  family             String?
  coupons            Int                @default(1)
  category           GuestCategory
  rsvpStatus         RsvpStatus         @default(PENDING)
  dietary            DietaryRequirement @default(STANDARD)
  plusOne            Boolean            @default(false)
  plusOneName        String?
  isChild            Boolean            @default(false)
  tableNumber        String?
  assignedSeats      String[]           @default([])
  phone              String?
  email              String?
  lodgingNeeded      Boolean            @default(false)
  notes              String?
  invitationSentDate DateTime?
  invitations        Invitation[]
  checkIn            CheckIn?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@index([coupleId])
  @@index([rsvpStatus])
  @@index([family])
}

model Invitation {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  coupleId    String           @db.ObjectId
  couple      Couple           @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  guestId     String           @db.ObjectId
  guest       Guest            @relation(fields: [guestId], references: [id], onDelete: NoAction)
  tokenHash   String           @unique
  status      InvitationStatus @default(ACTIVE)
  generatedAt DateTime         @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  usedAt      DateTime?
  checkIns    CheckIn[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([guestId])
  @@index([coupleId])
}

model CheckIn {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  guestId      String        @unique @db.ObjectId
  guest        Guest         @relation(fields: [guestId], references: [id], onDelete: NoAction)
  coupleId     String        @db.ObjectId
  couple       Couple        @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  invitationId String?       @db.ObjectId
  invitation   Invitation?   @relation(fields: [invitationId], references: [id], onDelete: NoAction)
  checkedInAt  DateTime      @default(now())
  operatorId   String?       @db.ObjectId
  operator     User?         @relation("CheckInOperator", fields: [operatorId], references: [id], onDelete: NoAction)
  deviceId     String?
  stationName  String?
  status       CheckInStatus @default(VALID)
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([coupleId])
  @@index([invitationId])
}

model RefreshSession {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id], onDelete: NoAction)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
