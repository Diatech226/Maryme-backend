generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COUPLE
  ACCESS_AGENT
}

enum CoupleStatus {
  PENDING
  AUTHORIZED
  SUSPENDED
}

enum GuestSide {
  GROOM
  BRIDE
}

enum GuestCategory {
  BRIDE_FAMILY
  GROOM_FAMILY
  WITNESS
  FRIENDS
  COLLEAGUES
  VIP
}

enum RsvpStatus {
  CONFIRMED
  PENDING
  DECLINED
}

enum DietaryRequirement {
  STANDARD
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  CHILD_MENU
  HALAL
  NO_SEAFOOD
}

enum InvitationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum InvitationDesignMode {
  GENERATED
  UPLOADED
}

enum CheckInStatus {
  VALID
  DUPLICATE
  REJECTED
}

enum CouponStatus {
  AVAILABLE
  ASSIGNED
  USED
  VOID
}

model User {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  email            String           @unique
  phone            String           @unique
  passwordHash     String
  role             UserRole
  firstName        String?
  lastName         String?
  isActive         Boolean          @default(true)
  coupleId         String?          @db.ObjectId
  couple           Couple?          @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  refreshSessions  RefreshSession[]
  operatedCheckIns CheckIn[]        @relation("CheckInOperator")
  audits           AuditLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastLoginAt      DateTime?

  @@index([coupleId])
}

model Couple {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  partner1             String
  partner2             String
  partner1FullName     String?
  partner2FullName     String?
  weddingDate          DateTime
  location             String
  email                String
  phone                String
  status               CoupleStatus         @default(PENDING)
  guestQuota           Int
  requestDate          DateTime             @default(now())
  authorizedAt         DateTime?
  notes                String?
  budgetEstimate       Int?
  bibleVerse           String?
  lunchVenue           String?
  lunchTime            String?
  churchVenue          String?
  churchTime           String?
  cityHallVenue        String?
  cityHallTime         String?
  groomFamilies        String[]             @default([])
  brideFamilies        String[]             @default([])
  users                User[]
  guests               Guest[]
  invitations          Invitation[]
  checkIns             CheckIn[]
  coupons              Coupon[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  accessOpensAt        DateTime?
  accessClosesAt       DateTime?
  invitationIntroText  String?
  invitationFooterText String?
  dressCode            String?
  rsvpMessage          String?
  invitationDesigns    InvitationDesign[]
  invitationArtifacts  InvitationArtifact[]
  weddingTables        WeddingTable[]

  @@index([status])
}

model Guest {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  coupleId            String               @db.ObjectId
  couple              Couple               @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  firstName           String
  lastName            String
  side                GuestSide
  family              String?
  coupons             Int                  @default(1)
  category            GuestCategory
  rsvpStatus          RsvpStatus           @default(PENDING)
  dietary             DietaryRequirement   @default(STANDARD)
  plusOne             Boolean              @default(false)
  plusOneName         String?
  isChild             Boolean              @default(false)
  tableNumber         String?
  tableId             String?              @db.ObjectId
  table               WeddingTable?        @relation(fields: [tableId], references: [id], onDelete: NoAction)
  assignedSeats       String[]             @default([])
  phone               String?
  email               String?
  lodgingNeeded       Boolean              @default(false)
  notes               String?
  externalRef         String?
  invitationSentDate  DateTime?
  invitations         Invitation[]
  checkIn             CheckIn?
  couponNumbers       Coupon[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  invitationArtifacts InvitationArtifact[]

  @@index([coupleId])
  @@index([rsvpStatus])
  @@index([family])
  @@index([coupleId, externalRef])
  @@index([tableId])
}

model WeddingTable {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  coupleId  String    @db.ObjectId
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  number    Int
  side      GuestSide
  capacity  Int?
  guests    Guest[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([coupleId, number])
  @@index([coupleId])
  @@index([coupleId, side])
}

model Coupon {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  coupleId   String       @db.ObjectId
  couple     Couple       @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  guestId    String?      @db.ObjectId
  guest      Guest?       @relation(fields: [guestId], references: [id], onDelete: NoAction)
  number     Int
  status     CouponStatus @default(AVAILABLE)
  assignedAt DateTime?
  usedAt     DateTime?
  releasedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([coupleId, number])
  @@index([coupleId, status])
  @@index([guestId])
}

model Invitation {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  coupleId    String               @db.ObjectId
  couple      Couple               @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  guestId     String               @db.ObjectId
  guest       Guest                @relation(fields: [guestId], references: [id], onDelete: NoAction)
  tokenHash   String               @unique
  status      InvitationStatus     @default(ACTIVE)
  generatedAt DateTime             @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  usedAt      DateTime?
  checkIns    CheckIn[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  artifacts   InvitationArtifact[]

  @@index([guestId])
  @@index([coupleId])
}

model InvitationDesign {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  coupleId            String               @db.ObjectId
  couple              Couple               @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  name                String
  mode                InvitationDesignMode
  templateKey         String?
  backgroundObjectKey String?
  backgroundMimeType  String?
  canvasWidth         Int?
  canvasHeight        Int?
  overlayConfig       Json
  contentConfig       Json?
  isActive            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  artifacts           InvitationArtifact[]

  @@index([coupleId])
  @@index([coupleId, isActive])
}

model InvitationArtifact {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  coupleId         String                @db.ObjectId
  couple           Couple                @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  guestId          String                @db.ObjectId
  guest            Guest                 @relation(fields: [guestId], references: [id], onDelete: NoAction)
  invitationId     String                @db.ObjectId
  invitation       Invitation            @relation(fields: [invitationId], references: [id], onDelete: NoAction)
  designId         String                @db.ObjectId
  design           InvitationDesign      @relation(fields: [designId], references: [id], onDelete: NoAction)
  imageObjectKey   String?
  pdfObjectKey     String?
  imageMimeType    String?
  pdfMimeType      String?
  guestUpdatedAt   DateTime
  designUpdatedAt  DateTime
  coupleUpdatedAt  DateTime?
  generatedAt      DateTime              @default(now())
  lastDownloadedAt DateTime?
  lastShareAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  shareLinks       InvitationShareLink[]

  @@index([coupleId])
  @@index([guestId])
  @@index([invitationId])
}

model InvitationShareLink {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  artifactId String             @db.ObjectId
  artifact   InvitationArtifact @relation(fields: [artifactId], references: [id], onDelete: NoAction)
  tokenHash  String             @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime           @default(now())
  openedAt   DateTime?

  @@index([artifactId])
  @@index([expiresAt])
}

model CheckIn {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  guestId      String        @unique @db.ObjectId
  guest        Guest         @relation(fields: [guestId], references: [id], onDelete: NoAction)
  coupleId     String        @db.ObjectId
  couple       Couple        @relation(fields: [coupleId], references: [id], onDelete: NoAction)
  invitationId String?       @db.ObjectId
  invitation   Invitation?   @relation(fields: [invitationId], references: [id], onDelete: NoAction)
  checkedInAt  DateTime      @default(now())
  operatorId   String?       @db.ObjectId
  operator     User?         @relation("CheckInOperator", fields: [operatorId], references: [id], onDelete: NoAction)
  deviceId     String?
  stationName  String?
  status       CheckInStatus @default(VALID)
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([coupleId])
  @@index([invitationId])
}

model RefreshSession {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id], onDelete: NoAction)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
